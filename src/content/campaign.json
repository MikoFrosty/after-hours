      "id": "01",
      "title": "The Night Desk",
      "verb": "Make and reinvest",
      "targetMinutes": "5 to 10",
      "art": "art/01-night-desk.png",
      "exitGuardDescription": "madeClips >= 3000 AND buildingLeaseAccepted",
      "acceptance": "Both all-salvage and no-salvage routes finish. Reopening the office later reproduces all three object flags.",
