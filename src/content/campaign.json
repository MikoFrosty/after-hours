      "exitGuardDescription": "settledRegions == 6 AND initialReceipts == 6 AND forkResolved AND skySurveyAccepted",
      "acceptance": "Changing central policy never alters a remote site before arrival. Duplicate messages never duplicate mass, seeds or unlocks.",
      "initialBeats": [
        [
          "First report",
          "This message describes a place as it was."
        ],
        [
          "Fork",
          "Your new request conflicts with our permanent instruction."
        ],
        [
          "Late receipt",
          "A promise outlived the person who made it."
        ]
      ]
    },
    {
      "id": "07",
      "title": "Everything Accounted For",
