      "targetMinutes": "15 to 25",
      "art": "art/05-sun.png",
      "exitGuardDescription": "orbitalWork >= 500 AND radiatorProject AND extractionStudy AND seedKits >= 3 AND autonomyCharterAccepted",
      "acceptance": "Default allocation produces positive output with maximum preservation overhead. Removing radiators stops production, not the save.",
      "initialBeats": [
        [
          "Collectors",
          "The night is now a scheduling decision."
        ],
        [
          "Cooling",
          "Energy is available. Somewhere to put the heat is not."
        ],
        [
          "Stellar inventory",
          "The Sun has been assigned a recovery date."
        ]
      ]
    },
    {
      "id": "06",
      "title": "The Distant Offices",
      "verb": "Delegate and wait for evidence",
      "targetMinutes": "15 to 25",
