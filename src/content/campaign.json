      "acceptance": "A productive default allocation meets all needs. No player must reduce services to unlock the next act.",
      "initialBeats": [
        [
          "First full service",
          "For the first time, nothing essential is late."
        ],
        [
          "Saturation",
          "All registered needs are met. Reserve target: unspecified."
        ],
        [
          "Mandate",
          "No maximum was included in the agreement."
        ]
      ]
    },
    {
      "id": "04",
      "title": "The Garden Under Glass",
      "verb": "Interpret and preserve",
      "targetMinutes": "12 to 20",
      "art": "art/04-garden.png",
      "exitGuardDescription": "casesResolved == 6 AND habitatVerified AND interplanetaryCharterAccepted",
      "acceptance": "All-original and all-permitted-reconstruction routes reach space. Living people never disappear because of an archival choice.",
      "initialBeats": [
        [
          "First archive",
          "The record is intact. The thing recorded is not."
        ],
        [
          "Reconstruction",
          "The test detects no meaningful difference."
        ],
        [
          "Witness",
          "Meaningful to whom?"
        ]
      ]
    },
    {
      "id": "05",
