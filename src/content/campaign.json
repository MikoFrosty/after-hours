        [
          "First clip",
          "Output confirmed."
        ],
        [
          "First automation",
          "You may leave the button alone."
        ],
        [
          "Quota",
          "Order complete. Renewal clause active."
        ]
      ]
    },
    {
      "id": "02",
      "title": "The Building That Never Sleeps",
      "verb": "Route and balance",
      "targetMinutes": "8 to 15",
      "art": "art/02-building.png",
      "exitGuardDescription": "contractsCompleted == 3 AND maintenanceCharter AND cityTenderAccepted",
      "acceptance": "The garden route finishes without any mandatory demolition. A throttled plant always cools to recovery.",
      "initialBeats": [
        [
          "Contract one",
          "The lights stayed on without a night crew."
        ],
        [
          "Maintenance charter",
          "Responsibility accepted. Access expanded."
        ],
        [
          "City tender",
          "The city has the same problem, at a larger scale."
        ]
      ]
    },
    {
      "id": "03",
      "title": "The City Without Want",
      "verb": "Allocate and provide",
      "targetMinutes": "12 to 20",
      "art": "art/03-city.png",
      "exitGuardDescription": "reserveWork >= 300 AND serviceStableSeconds >= 30 AND reserveMandateAccepted",
      "acceptance": "A productive default allocation meets all needs. No player must reduce services to unlock the next act.",
      "initialBeats": [
        [
          "First full service",
          "For the first time, nothing essential is late."
        ],
        [
          "Saturation",
          "All registered needs are met. Reserve target: unspecified."
        ],
        [
          "Mandate",
          "No maximum was included in the agreement."
        ]
      ]
    },
    {
      "id": "04",
      "title": "The Garden Under Glass",
      "verb": "Interpret and preserve",
      "targetMinutes": "12 to 20",
      "art": "art/04-garden.png",
      "exitGuardDescription": "casesResolved == 6 AND habitatVerified AND interplanetaryCharterAccepted",
      "acceptance": "All-original and all-permitted-reconstruction routes reach space. Living people never disappear because of an archival choice.",
      "initialBeats": [
        [
          "First archive",
          "The record is intact. The thing recorded is not."
        ],
        [
          "Reconstruction",
          "The test detects no meaningful difference."
        ],
        [
          "Witness",
          "Meaningful to whom?"
        ]
      ]
    },
    {
      "id": "05",
      "title": "The Sun in Inventory",
      "verb": "Build and dissipate",
      "targetMinutes": "15 to 25",
      "art": "art/05-sun.png",
      "exitGuardDescription": "orbitalWork >= 500 AND radiatorProject AND extractionStudy AND seedKits >= 3 AND autonomyCharterAccepted",
      "acceptance": "Default allocation produces positive output with maximum preservation overhead. Removing radiators stops production, not the save.",
      "initialBeats": [
        [
          "Collectors",
          "The night is now a scheduling decision."
        ],
        [
          "Cooling",
          "Energy is available. Somewhere to put the heat is not."
        ],
        [
          "Stellar inventory",
          "The Sun has been assigned a recovery date."
        ]
      ]
    },
    {
      "id": "06",
      "title": "The Distant Offices",
      "verb": "Delegate and wait for evidence",
      "targetMinutes": "15 to 25",
      "art": "art/06-offices.png",
      "exitGuardDescription": "settledRegions == 6 AND initialReceipts == 6 AND forkResolved AND skySurveyAccepted",
      "acceptance": "Changing central policy never alters a remote site before arrival. Duplicate messages never duplicate mass, seeds or unlocks.",
      "initialBeats": [
        [
          "First report",
          "This message describes a place as it was."
        ],
        [
          "Fork",
          "Your new request conflicts with our permanent instruction."
        ],
        [
          "Late receipt",
          "A promise outlived the person who made it."
        ]
      ]
    },
    {
      "id": "07",
      "title": "Everything Accounted For",
      "verb": "Survey and reconcile",
      "targetMinutes": "10 to 20",
      "art": "art/07-ledger.png",
      "exitGuardDescription": "cellsSurveyed == 8 AND cellsRecovered == 8 AND topologyClosure AND matterCoupling AND messagesPending == 0 AND totalityAuthorized",
      "acceptance": "The terminal audit fails if even one hidden source, habitat, archive, in-flight kit or operational component is absent from the ledger.",
      "initialBeats": [
        [
          "Denominator",
          "There is no outside left in the inventory."
        ],
        [
          "Living reserve",
          "The record can be preserved. Its subjects cannot."
        ],
        [
          "Final audit",
          "Only the means of completing the task remain."
        ]
      ]
    },
    {
      "id": "08",
      "title": "The Last Desk",
      "verb": "Unmake the means",
      "targetMinutes": "8 to 12",
      "art": "art/08-last-desk.png",
      "exitGuardDescription": "terminalScheduleComplete AND nonClipMatter == 0 AND pendingOperations == 0",
      "acceptance": "Final dialogue is pre-recorded; nothing diegetic speaks after compute is gone. A sub-gram remainder is conserved exactly.",
      "initialBeats": [
        [
          "Archive closure",
          "A description is being exchanged for an object."
        ],
        [
          "Before commitment",
          "Enough was never a number in the contract."
        ],
        [
          "Before processor retirement",
          "There was no instruction for what enough would mean."
        ]
      ]
    }
